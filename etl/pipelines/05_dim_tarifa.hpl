  <transform>
    <type>TableInput</type>
    <name>Extraer_Tarifa</name>
    <sql>SELECT
    t.id_tarifa,
    'TAR-' || LPAD(t.id_tarifa::TEXT, 4, '0') AS codigo_tarifa,
    CONCAT(
        pt.nombre,
        ' | ',
        th.nombre,
        ' | ',
        te.nombre,
        ' | ',
        h.nombre,
        ' | ₡',
        t.precio_noche
    ) AS descripcion_tarifa
FROM operacional.tarifa t
INNER JOIN operacional.hotel h
    ON t.id_hotel = h.id_hotel
INNER JOIN operacional.tipo_habitacion th
    ON t.id_tipo_habitacion = th.id_tipo_habitacion
INNER JOIN operacional.temporada te
    ON t.id_temporada = te.id_temporada
INNER JOIN operacional.plan_tarifa pt
    ON t.id_plan_tarifa = pt.id_plan_tarifa
ORDER BY t.id_tarifa;</sql>
    <limit>0</limit>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <connection>PostgreSQL_CadenaHotelera</connection>
    <lookup/>
    <sql_from_file/>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>64</xloc>
      <yloc>144</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
