  <transform>
    <type>TableInput</type>
    <name>Extraer_Hotel</name>
    <sql>SELECT
    h.id_hotel,
    h.nombre AS nombre_hotel,
    h.ciudad,
    CONCAT(h.categoria_estrellas, ' estrellas') AS categoria,
    COUNT(ha.id_habitacion) FILTER (WHERE ha.estado = 'ACTIVA')
        AS total_habitaciones_disponibles
FROM operacional.hotel h
LEFT JOIN operacional.habitacion ha
    ON h.id_hotel = ha.id_hotel
GROUP BY
    h.id_hotel,
    h.nombre,
    h.ciudad,
    h.categoria_estrellas
ORDER BY h.id_hotel;</sql>
    <limit>0</limit>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <connection>PostgreSQL_CadenaHotelera</connection>
    <lookup/>
