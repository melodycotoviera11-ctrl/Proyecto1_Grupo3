  <transform>
    <type>TableInput</type>
    <name>Generar_Dim_Fecha</name>
    <sql>WITH limites AS (
    SELECT
        MIN(fecha_reserva) AS fecha_min,
        MAX(fecha_salida_prevista) AS fecha_max
    FROM operacional.reserva
),
calendario AS (
    SELECT
        generate_series(
            fecha_min,
            fecha_max,
            INTERVAL '1 day'
        )::DATE AS fecha
    FROM limites
)
SELECT
    TO_CHAR(c.fecha, 'YYYYMMDD')::INTEGER AS id_fecha,
    c.fecha,
    EXTRACT(YEAR FROM c.fecha)::INTEGER AS anio,
    EXTRACT(QUARTER FROM c.fecha)::INTEGER AS trimestre,
    EXTRACT(MONTH FROM c.fecha)::INTEGER AS mes,
    CASE EXTRACT(ISODOW FROM c.fecha)
        WHEN 1 THEN 'Lunes'
        WHEN 2 THEN 'Martes'
        WHEN 3 THEN 'Miércoles'
        WHEN 4 THEN 'Jueves'
        WHEN 5 THEN 'Viernes'
        WHEN 6 THEN 'Sábado'
        WHEN 7 THEN 'Domingo'
    END AS dia_de_la_semana,
    COALESCE(
        (
            SELECT te.tipo
            FROM operacional.temporada te
            WHERE c.fecha BETWEEN te.fecha_inicio AND te.fecha_fin
            LIMIT 1
        ),
        'SIN TEMPORADA'
    ) AS temporada
FROM calendario c
ORDER BY c.fecha;</sql>
    <limit>0</limit>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <connection>PostgreSQL_CadenaHotelera</connection>
    <lookup/>
    <sql_from_file/>
    <distribute>Y</distribute>
    <copies>1</copies>
