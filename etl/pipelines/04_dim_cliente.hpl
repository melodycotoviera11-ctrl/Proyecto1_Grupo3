  <transform>
    <type>TableInput</type>
    <name>Extraer_Cliente</name>
    <sql>SELECT
    h.id_huesped AS id_cliente,
    h.nombre,
    s.nombre AS segmento_cliente,
    CASE
        WHEN s.nombre = 'Individual' THEN 'Viajero individual'
        WHEN s.nombre = 'Pareja' THEN 'Turismo en pareja'
        WHEN s.nombre = 'Familia' THEN 'Turismo familiar'
        WHEN s.nombre = 'Corporativo' THEN 'Viajero de negocios'
        ELSE 'Sin clasificar'
    END AS perfil_huesped
FROM operacional.huesped h
INNER JOIN operacional.segmento_huesped s
    ON h.id_segmento = s.id_segmento
ORDER BY h.id_huesped;</sql>
    <limit>0</limit>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <connection>PostgreSQL_CadenaHotelera</connection>
    <lookup/>
    <sql_from_file/>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
