  <transform>
    <type>TableInput</type>
    <name>Extraer_Habitacion</name>
    <sql>SELECT
    h.id_habitacion,
    th.nombre AS tipo_habitacion,
    th.capacidad
FROM operacional.habitacion h
INNER JOIN operacional.tipo_habitacion th
    ON h.id_tipo_habitacion = th.id_tipo_habitacion
ORDER BY h.id_habitacion;</sql>
    <limit>0</limit>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <connection>PostgreSQL_CadenaHotelera</connection>
    <lookup/>
    <sql_from_file/>
    <distribute>Y</distribute>
