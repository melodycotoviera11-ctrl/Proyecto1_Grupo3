  <transform>
    <type>TableInput</type>
    <name>Extraer_Canal</name>
    <sql>SELECT
    id_canal,
    nombre AS nombre_canal,
    CASE
        WHEN nombre = 'Sitio web' THEN 'Directo digital'
        WHEN nombre IN ('Teléfono', 'Recepción') THEN 'Directo tradicional'
        WHEN nombre IN ('Agencia', 'OTA') THEN 'Intermediado'
        ELSE 'Otro'
    END AS tipo_canal
FROM operacional.canal_reserva
ORDER BY id_canal;</sql>
    <limit>0</limit>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <connection>PostgreSQL_CadenaHotelera</connection>
    <lookup/>
