  <transform>
    <type>TableInput</type>
    <name>Extraer_Reservas_Base</name>
    <sql>SELECT
    r.id_reserva,
    r.id_canal,
    h.id_hotel,

    TO_CHAR(r.fecha_reserva, 'YYYYMMDD')::INTEGER
        AS id_fecha_reserva,

    dr.id_habitacion,

    r.id_huesped AS id_cliente,

    dr.id_tarifa,

    CASE
        WHEN e.fecha_checkin IS NOT NULL
        THEN TO_CHAR(e.fecha_checkin, 'YYYYMMDD')::INTEGER
        ELSE TO_CHAR(r.fecha_entrada_prevista, 'YYYYMMDD')::INTEGER
    END AS id_fecha_checkin,

    CASE
        WHEN e.fecha_checkin IS NOT NULL
         AND e.fecha_checkout IS NOT NULL
        THEN e.fecha_checkout - e.fecha_checkin
        ELSE dr.cantidad_noches
    END AS duracion_estadia_noches,

    dr.subtotal_alojamiento AS ingreso_alojamiento,

    COALESCE(svc.ingreso_desayuno, 0) AS ingreso_desayuno,
    COALESCE(svc.ingreso_almuerzo, 0) AS ingreso_almuerzo,
    COALESCE(svc.ingreso_cena, 0) AS ingreso_cena,
    COALESCE(svc.ingreso_spa, 0) AS ingreso_spa,
    COALESCE(svc.ingreso_lavanderia, 0) AS ingreso_lavanderia,
    COALESCE(svc.ingreso_tour, 0) AS ingreso_tour,
    COALESCE(svc.ingreso_transporte, 0) AS ingreso_transporte,
    COALESCE(svc.ingreso_room_service, 0) AS ingreso_room_service,

    COALESCE(svc.ingreso_servicios_complementarios, 0)
        AS ingreso_servicios_complementarios,

    CASE
        WHEN r.estado = 'CANCELADA' THEN TRUE
        ELSE FALSE
    END AS es_cancelacion,

    CASE
        WHEN r.estado = 'NO_SHOW' THEN TRUE
        ELSE FALSE
    END AS es_noshow

FROM operacional.reserva r

INNER JOIN operacional.detalle_reserva dr
    ON r.id_reserva = dr.id_reserva

INNER JOIN operacional.habitacion hab
    ON dr.id_habitacion = hab.id_habitacion

INNER JOIN operacional.hotel h
    ON hab.id_hotel = h.id_hotel

LEFT JOIN operacional.estadia e
    ON dr.id_detalle_reserva = e.id_detalle_reserva

LEFT JOIN (
    SELECT
        dr2.id_reserva,

        SUM(CASE
            WHEN s.nombre = 'Desayuno'
            THEN cs.total
            ELSE 0
        END) AS ingreso_desayuno,

        SUM(CASE
            WHEN s.nombre = 'Almuerzo'
            THEN cs.total
            ELSE 0
        END) AS ingreso_almuerzo,

        SUM(CASE
            WHEN s.nombre = 'Cena'
            THEN cs.total
            ELSE 0
        END) AS ingreso_cena,

        SUM(CASE
            WHEN s.nombre = 'Spa'
            THEN cs.total
            ELSE 0
        END) AS ingreso_spa,

        SUM(CASE
            WHEN s.nombre = 'Lavandería'
            THEN cs.total
            ELSE 0
        END) AS ingreso_lavanderia,

        SUM(CASE
            WHEN s.nombre = 'Tour'
            THEN cs.total
            ELSE 0
        END) AS ingreso_tour,

        SUM(CASE
            WHEN s.nombre = 'Transporte'
            THEN cs.total
            ELSE 0
        END) AS ingreso_transporte,

        SUM(CASE
            WHEN s.nombre = 'Room Service'
            THEN cs.total
            ELSE 0
        END) AS ingreso_room_service,

        SUM(cs.total) AS ingreso_servicios_complementarios

    FROM operacional.detalle_reserva dr2

    INNER JOIN operacional.estadia e2
        ON dr2.id_detalle_reserva = e2.id_detalle_reserva

    INNER JOIN operacional.consumo_servicio cs
        ON e2.id_estadia = cs.id_estadia

    INNER JOIN operacional.servicio s
        ON cs.id_servicio = s.id_servicio

    GROUP BY dr2.id_reserva
) svc
    ON r.id_reserva = svc.id_reserva

ORDER BY r.id_reserva;</sql>
    <limit>0</limit>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <connection>PostgreSQL_CadenaHotelera</connection>
